# --- Required ---
GEMINI_API_KEY=your_gemini_api_key_here
# Any Gemini model your key can access (check https://ai.google.dev/gemini-api/docs/models)
GEMINI_MODEL=gemini-flash-latest

# --- Image generation (Hugging Face Diffusers) ---
# Any Stable Diffusion-compatible Diffusers repo id or local folder.
IMAGE_MODEL=Lykon/dreamshaper-8
# auto | cuda | mps | cpu
IMAGE_DEVICE=auto

# --- Optional tuning (leave blank for defaults) ---
# IMAGE_WIDTH=576
# IMAGE_HEIGHT=448
# IMAGE_STEPS=          # default: 25 on GPU, 15 on CPU
# IMAGE_GUIDANCE=7.0
# IMAGE_SEED=           # blank = random per comic; set a number for reproducible comics
# IMAGE_NEGATIVE_PROMPT=
# HF_TOKEN=             # only needed for gated/private models (not for the default)
# PDF_FONT_PATH=        # path to a Unicode .ttf for non-Latin text in PDFs
